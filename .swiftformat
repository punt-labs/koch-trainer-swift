# SwiftFormat configuration for Koch Trainer

# Swift version
--swiftversion 5.9

# Formatting options
--indent 4
--indentcase false
--trimwhitespace always
--voidtype void
--maxwidth 120
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--wrapconditions after-first
--closingparen balanced
--allman false
--funcattributes prev-line
--typeattributes prev-line
--varattributes prev-line
--self remove
--importgrouping alpha
--semicolons never
--commas inline
--stripunusedargs closure-only

# Enable/disable rules
--enable isEmpty
--enable sortedImports
--enable wrapEnumCases
--enable wrapSwitchCases
--enable markTypes
--enable organizeDeclarations

--disable redundantReturn
--disable blankLinesAtEndOfScope
--disable blankLinesAtStartOfScope
--disable trailingCommas
--disable wrapMultilineStatementBraces
# repeatedGuard merges consecutive `guard` statements into one comma-delimited
# guard. That inflates function bodies past SwiftLint's function_body_length
# warning (60 lines) — e.g. ToneGenerator.startContinuousAudio() goes to 62.
# Keeping guards separate is the established style here; disable the rule so
# SwiftFormat and SwiftLint agree instead of fighting each run.
--disable repeatedGuard

# Exclusions
--exclude DerivedData,Pods,.build,Carthage
